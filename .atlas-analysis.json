  "keyFeatures": [
    "HTML & Excel timetable upload with automatic parsing",
    "Automated student seating chart import and validation",
    "Intelligent block allocation with supervisor assignment",
    "Complete staff management (supervisors, relievers, control room)",
    "Official MSBTE F1–F22 report generation",
    "Question paper inventory tracking and packet accounting",
    "Live exam-day dashboard with real-time attendance and copy case management",
    "Automated office order generation via email",
    "Multi-institute support with connected institute management",
    "Razorpay-integrated subscription and billing system",
    "Docker-based deployment with PostgreSQL 16",
    "Better Auth with Google OAuth"
  ],
  "publicApiSurface": [
